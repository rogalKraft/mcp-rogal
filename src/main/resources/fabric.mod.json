{
	"schemaVersion": 1,
	"id": "mcp-rogal",
	"version": "${version}",
	"name": "MCP-rogal",
	"description": "An MCP server for developing Minecraft mods and datapacks: real command results, searchable live logs, keyboard and mouse control, sandboxed datapack files, and fake players for testing multiplayer rules.",
	"authors": [
		"rogalKraft"
	],
	"credits": [
		"cuspymd - original mcp-server-mod this project started from"
	],
	"contact": {
		"homepage": "https://github.com/rogalKraft/mcp-rogal",
		"sources": "https://github.com/rogalKraft/mcp-rogal",
		"issues": "https://github.com/rogalKraft/mcp-rogal/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/mcp-rogal/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"org.wallet.rogalik.mcp.MCPServerMod"
		],
		"client": [
			"org.wallet.rogalik.mcp.MCPServerModClient"
		],
		"server": [
			"org.wallet.rogalik.mcp.MCPServerModServer"
		]
	},
	"mixins": [
		"mcp-rogal.mixins.json",
		{
			"config": "mcp-rogal.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
